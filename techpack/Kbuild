TECHPACK?=y

# OnePlus feature macros (OPLUS_BUG_STABILITY, OPLUS_FEATURE_*, ...) that the
# msm-5.4 techpacks were built with. Scoped to techpack/ only.
include $(srctree)/OplusKernelEnvConfig.mk

techpack-dirs := $(shell find $(srctree)/techpack -maxdepth 1 -mindepth 1 -type d -not -name ".*")
obj-${TECHPACK} += stub/ $(addsuffix /,$(subst $(srctree)/techpack/,,$(techpack-dirs)))
