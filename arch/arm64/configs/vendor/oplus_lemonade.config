# OnePlus 9 (lemonade) OnePlus-driver fragment, applied after
# gki_defconfig and vendor/lahaina_GKI.config.

# Alert Slider
CONFIG_IST_DOWN=m
CONFIG_IST_UP=m
CONFIG_MXM_DOWN=m
CONFIG_MXM_UP=m
CONFIG_OPLUS_TRIKEY_HALL=m
CONFIG_OPLUS_TRIKEY_MAIN=m

# Fingerprint (goodix_optical_fp needs the drm_panel notifier path ported)
# CONFIG_OPLUS_FINGERPRINT is not set

# Haptics (aw8697 not ported yet)
# CONFIG_AW8697_HAPTIC is not set

# Misc
CONFIG_OPLUS_FEATURE_BUILDVARIANT=m
CONFIG_OPLUS_FEATURE_CMDLINE=m
CONFIG_OPLUS_FEATURE_FEEDBACK=m
CONFIG_OPLUS_FEATURE_OPLUSBOOT=m
CONFIG_OPLUS_FEATURE_OPROJECT=m
CONFIG_OPLUS_FEATURE_PROJECTINFO=m
CONFIG_OPLUS_FEATURE_SIMCARDNUM=m
CONFIG_OEM_QMI=m
CONFIG_OPLUS_GPIO=m
CONFIG_OPLUS_SYSTEM_KERNEL=y
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y

# Power (OnePlus 9 charging is not ported yet)
# CONFIG_OPLUS_CHG is not set

# Sensor
CONFIG_OPLUS_FEATURE_SENSOR_CFG=m
CONFIG_OPLUS_SENSOR_FB_QC=m
# CONFIG_SSC_INTERACTIVE is not set

# Thermal
CONFIG_HORAE_THERMAL_SHELL=m

# Touchpanel (oplus_touchscreen_v2 Samsung S6SY792 not ported yet)
CONFIG_OPLUS_DEVICE_IFNO=m
# CONFIG_TOUCHPANEL_OPLUS is not set
CONFIG_TOUCHPANEL_NOTIFY=m
# CONFIG_FTS_TRUSTED_TOUCH is not set
# CONFIG_NOVATEK_TRUSTED_TOUCH is not set
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
